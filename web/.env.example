# PCB Designer AI Agent — Environment Variables
# Copy to .env and fill in values, or export in your shell

# ┌─────────────────────────────────────────────┐
# │ LLM Provider Configuration                  │
# └─────────────────────────────────────────────┘

# Default provider used when none specified per-call.
# Available: poolside, openrouter, openai, anthropic,
#            gemini, lmstudio, ollama
PCB_AI_LLM_PROVIDER=poolside

# LLM model overrides (optional — each provider has its own default)
PCB_AI_MODEL=
PCB_AI_OPENAI_MODEL=gpt-4o-mini
PCB_AI_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
PCB_AI_GEMINI_MODEL=gemini-2.0-flash
PCB_AI_OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# ┌─────────────────────────────────────────────┐
# │ API Keys (only needed for cloud providers)  │
# └─────────────────────────────────────────────┘

# Poolside uses OpenRouter under the hood
OPENROUTER_API_KEY=

# Direct provider keys (if not using poolside/OpenRouter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ┌─────────────────────────────────────────────┐
# │ Local Provider Settings                     │
# └─────────────────────────────────────────────┘

# LMStudio local API endpoint
LMSTUDIO_API_URL=http://localhost:1234/v1

# Ollama local API endpoint
OLLAMA_API_URL=http://localhost:11434

# ┌─────────────────────────────────────────────┐
# │ Web Server                                  │
# └─────────────────────────────────────────────┘

PCB_AI_PORT=5000
PCB_AI_HOST=0.0.0.0
FLASK_ENV=development
